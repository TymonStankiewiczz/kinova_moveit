<?xml version="1.0" encoding="UTF-8"?>
<!--
  SRDF Kinova Gen3 dla MoveIt2 - napisany od zera (nie z pakietu producenta).
  "world" jest już połączony z "base_link" sztywnym jointem bezpośrednio w
  kinova_gen3.urdf.xacro, więc nie deklarujemy tu virtual_joint.
-->
<robot name="kinova_gen3">

  <group name="arm">
    <chain base_link="base_link" tip_link="end_effector_link"/>
  </group>

  <!-- Nazwane pozycje do szybkich testów w RViz (MotionPlanning -> Goal State) -->
  <group_state name="home" group="arm">
    <joint name="joint_1" value="0.0"/>
    <joint name="joint_2" value="0.26"/>
    <joint name="joint_3" value="3.14"/>
    <joint name="joint_4" value="-2.27"/>
    <joint name="joint_5" value="0.0"/>
    <joint name="joint_6" value="0.96"/>
    <joint name="joint_7" value="1.57"/>
  </group_state>

  <group_state name="vertical" group="arm">
    <joint name="joint_1" value="0.0"/>
    <joint name="joint_2" value="0.0"/>
    <joint name="joint_3" value="0.0"/>
    <joint name="joint_4" value="0.0"/>
    <joint name="joint_5" value="0.0"/>
    <joint name="joint_6" value="0.0"/>
    <joint name="joint_7" value="0.0"/>
  </group_state>

  <!-- Brak osobnej grupy/chwytaka w tej wersji (samo ramię 7-DOF) - nie
       deklarujemy więc tagu end_effector. -->

  <!-- Pary linków, które fizycznie się stykają - wyłączone z self-collision checking -->
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="half_arm_1_link" reason="Adjacent"/>
  <disable_collisions link1="half_arm_1_link" link2="half_arm_2_link" reason="Adjacent"/>
  <disable_collisions link1="half_arm_2_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="spherical_wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="spherical_wrist_1_link" link2="spherical_wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="spherical_wrist_2_link" link2="bracelet_link" reason="Adjacent"/>

</robot>
